+ * Rendered as flat 1-bit pixels via ctx.setPixel; the editor's draw()
+ * overrides ctx.print/ctx.measureText with these, so all layout code renders
+ * in this font. Uppercase only; 5px glyph + 1px gap = 6px advance. */
+var PF_GLYPH_W = 5, PF_GLYPH_H = 5, PF_ADVANCE = 6;
+var PF_FONT = {
+  "A": ["01110", "10001", "11111", "10001", "10001"],
+  "B": ["11110", "10001", "11110", "10001", "11110"],
+  "C": ["01111", "10000", "10000", "10000", "01111"],
