+
+/* Split an enum value into two <=3-char lines for the enum square (movy's
+ * enumSquareLines): word-split when possible, else a hard split. Configs can
+ * sidestep bad auto-splits ("KEE/P") with per-option `sq` labels (enumc). */
+function enumSquareLines(value) {
+  var parts = String(value).toUpperCase().replace(/[_\-]/g, " ").trim().split(/\s+/);
+  if (parts.length >= 2) return [parts[0].substring(0, 3), parts[1].substring(0, 3)];
+  var w = parts[0];
