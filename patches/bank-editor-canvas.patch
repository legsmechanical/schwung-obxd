+
+/* ---- cell descriptor constructors (native-int chain contract) ----
+ * The config builds its banks from these. Continuous kinds step every
+ * KIT_SENS detents; enum cells step every KIT_ENUM_SENS detents and CLAMP at
+ * their ends rather than wrapping — an accidental extra detent shouldn't
+ * flip On back to Off. All read KIT_PARAM_MAX at call time, so a config that
+ * reassigns it must do so BEFORE building its banks. */
+
+const kToggleLabels = ["Off", "On"];
+
+/* Continuous 0..KIT_PARAM_MAX, rendered as an arc knob. */
+function uni(key, label) { return { key, label, kind: "unipolar", min: 0, max: KIT_PARAM_MAX, step: 1, sens: KIT_SENS }; }
+/* Center-detent continuous (pan, tune): arc knob with a 12-o'clock tick;
+ * value shows signed offset from center; center-out bar semantics. */
+function bip(key, label) { return { key, label, kind: "bipolar", min: 0, max: KIT_PARAM_MAX, step: 1, sens: KIT_SENS, dflt: Math.round(KIT_PARAM_MAX / 2) }; }
+/* On/Off toggle, rendered as a movy horizontal bar. */
+function tog(key, label) { return { key, label, kind: "enum", min: 0, max: 1, step: 1, sens: KIT_ENUM_SENS, options: kToggleLabels }; }
+/* Multi-option enum, rendered as a framed square + a scrolling list overlay
+ * while touched. `sq` (optional): per-option single-line square labels. */
+function enumc(key, label, options, sq) { return { key, label, kind: "enum", min: 0, max: options.length - 1, step: 1, sens: KIT_ENUM_SENS, options, sq }; }
+/* Small signed range (+N display), rendered as a value square. */
+function oct(key, label, lo, hi) { return { key, label, kind: "octave", min: lo, max: hi, step: 1, sens: 3 }; }
+/* Small positive count, rendered as a value square. */
+function count(key, label, lo, hi) { return { key, label, kind: "count", min: lo, max: hi, step: 1, sens: 3 }; }
+/* Envelope-stage cell (use on `env: true` banks, cells 0-3 = A/D/S/R drive
+ * the full-width envelope graphic; other fader cells render as a vbar). */
+function fader(key, label) { return { key, label, kind: "fader", min: 0, max: KIT_PARAM_MAX, step: 1, sens: KIT_SENS }; }
+/* Empty grid slot (keeps knob positions aligned in dynamicCells layouts). */
+function blank() { return { key: null, label: "", kind: "blank" }; }
+/* Waveform-shape enum: like enumc, but the widget draws the selected shape's
+ * actual waveform (shapeSample) instead of its name. `shapes` = one shape id
+ * per option: "sine" | "tri" | "saw" | "square" | "sh" | "swishy". */
+function wavesel(key, label, options, shapes) { return { key, label, kind: "waveenum", min: 0, max: options.length - 1, step: 1, sens: KIT_ENUM_SENS, options, shapes }; }
+
+/* Bipolar (-1..1) sample of an LFO shape at phase t (one cycle = 1). s&h and
+ * swishy use fixed deterministic patterns so frames are stable (from
+ * schwung-movy src/renderer/lfo-wave.ts, MIT (c) 2026 megadake). */
+function shapeSample(shape, t) {
+  var ph = t - Math.floor(t);
+  switch (shape) {
+    case "tri":
+      if (ph < 0.25) return ph * 4;
+      if (ph < 0.75) return 1 - (ph - 0.25) * 4;
+      return -1 + (ph - 0.75) * 4;
+    case "saw": return ph * 2 - 1;
+    case "square": return ph < 0.5 ? 1 : -1;
+    case "sh": {
+      var steps = [0.3, -0.7, 0.85, -0.35];
+      return steps[Math.floor(ph * steps.length) % steps.length];
+    }
+    case "swishy": {
+      var pts = [0, 0.7, -0.4, 0.55, -0.8, 0.2, 0];
+      var x = ph * (pts.length - 1);
+      var i = Math.floor(x), f = x - i;
+      return pts[i] + (pts[Math.min(i + 1, pts.length - 1)] - pts[i]) * f;
+    }
+    default: return Math.sin(ph * 2 * Math.PI); // sine
+  }
+}
